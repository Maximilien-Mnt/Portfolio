# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional until prompt P9) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # legacy "anon" or new "publishable" key — both work
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY. Never prefix with NEXT_PUBLIC. Legacy name / new "secret" key

# --- PostHog (optional until prompt P10) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com   # or https://us.i.posthog.com — match your PostHog region

# --- Cloudflare Turnstile (anti-bot for guestbook + contact) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contact notifications (optional) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# --- Keep-alive cron (stops free Supabase from pausing) ---
CRON_SECRET=

# --- Guestbook owner point (optional; public row id rendered Signal-colored) ---
NEXT_PUBLIC_OWNER_POINT_ID=

# --- Contact email (optional; Resend) ---
CONTACT_FROM_EMAIL=
